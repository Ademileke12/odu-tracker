UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=AXxx...

# Admin gate — generated values (see the handover message / password manager)
ADMIN_PASSWORD_HASH=pbkdf2$100000$<salt-b64>$<hash-b64>
SESSION_SECRET=<64-hex>
